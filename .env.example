# Copy to .env and set unique values before running beyond local development.
APP_NAME=Office Task & Performance Management System
APP_ENV=development
# Bind only to the local machine for direct Python development. Docker Compose publishes
# the web app on all interfaces; firewall access must be restricted to the office LAN.
APP_HOST=0.0.0.0
APP_PORT=8000
# Docker host bind address; prefer the reserved LAN IP for office deployment.
APP_BIND_IP=0.0.0.0
# Replace this placeholder with a long random value. Never commit your real .env.
SECRET_KEY=replace-this-with-at-least-32-random-bytes
SESSION_MAX_AGE_SECONDS=28800
# IANA timezone used for shift windows and local duty dates; database timestamps are UTC.
OFFICE_TIMEZONE=Africa/Dar_es_Salaam

# PostgreSQL is intentionally not published to the host in docker-compose.yml.
POSTGRES_DB=officetask
POSTGRES_USER=officetask
POSTGRES_PASSWORD=replace-with-a-unique-long-password
DATABASE_URL=postgresql+psycopg://officetask:replace-with-a-unique-long-password@localhost:5432/officetask

# Private local file storage; do not serve this directory as static web content.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# Backups are planned for the deployment phase. Keep backup location on protected storage.
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=30
